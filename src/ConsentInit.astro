---
/**
 * Google Consent Mode v2 defaults. MUST render before the tag manager loader,
 * otherwise tags fire once with no consent state and the first pageview leaks.
 *
 * Also publishes `window.gtag` so the rest of the page shares one dataLayer contract
 * instead of each script defining its own shim.
 */
import initSource from './consent-init.js?raw';

interface Props {
  /**
   * Sites that run advertising set this to false and grant the ad_* signals from
   * their own banner. Left true, the three ad signals stay denied for good and the
   * banner never touches them.
   */
  adSignalsAlwaysDenied?: boolean;
  /** How long the tag manager holds tags waiting for an update, in milliseconds. */
  waitForUpdate?: number;
}

const { adSignalsAlwaysDenied = true, waitForUpdate = 500 } = Astro.props;
---
<script
  is:inline
  data-ad-signals-always-denied={String(adSignalsAlwaysDenied)}
  data-wait-for-update={String(waitForUpdate)}
  set:html={initSource}
/>
