---
/**
 * The banner and the preferences dialog. Renders nothing itself until the script runs,
 * so it can sit anywhere in the body.
 *
 * Copy and the cookie list are props: wording is not portable between sites, and a
 * shared cookie list would claim cookies a site never writes.
 */
import type { MeasurementCookie } from './cookie-inventory';
import type { ConsentCopy } from './types';

interface Props {
  /** Language tag for the copy being passed in. One language per render. */
  lang: string;
  copy: ConsentCopy;
  policyUrl: string;
  policyLabel: string;
  /** The cookies the analytics category writes. Drives autoClear and the table. */
  cookies: MeasurementCookie[];
  /**
   * Class on <html> that means dark. The library themes itself off `cc--darkmode`,
   * which this mirrors rather than guessing from prefers-color-scheme, since the host
   * site's own resolver owns the class.
   */
  darkClass?: string;
}

const { lang, copy, policyUrl, policyLabel, cookies, darkClass = 'dark' } = Astro.props;

const config = {
  lang,
  policyUrl,
  policyLabel,
  darkClass,
  banner: copy.banner,
  preferences: copy.preferences,
  cookies: cookies.map((cookie) => ({
    name: cookie.name,
    // RegExp does not survive JSON, so the pattern crosses as source + flags.
    pattern: { source: cookie.pattern.source, flags: cookie.pattern.flags },
    vendor: cookie.vendor,
    domain: cookie.domain,
    duration: cookie.duration,
  })),
};
---
<script type="application/json" id="cc-config" is:inline set:html={JSON.stringify(config)}></script>

<script>
  import 'vanilla-cookieconsent/dist/cookieconsent.css';
  import './banner-runtime';
</script>
